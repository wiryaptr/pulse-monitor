# Salin menjadi .env untuk mengubah nilai bawaan compose (file .env tidak ikut di-commit).
#   cp .env.example .env

# Alamat dan port web di mesin ini. Biarkan 127.0.0.1 selama belum ada autentikasi.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Detik antar pembacaan (minimal 0.5) dan batas koneksi /stream bersamaan
PULSE_INTERVAL=2.0
MAX_STREAMS=20
